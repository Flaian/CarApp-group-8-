<!-- CarApp.Wpf/Views/MainView.xaml -->
<Window x:Class="CarApp.Wpf.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarApp" Height="600" Width="800">
    
    
    <DockPanel>

        <!-- Navigationsmenu i toppen -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    Background="#1F4E79" Margin="0,0,0,4">
            <!-- TODO: Command bundet til ShowCarsCommand -->
            <Button Content="🚗  Cars"
                    Command="{Binding ShowCarsCommand}"
                    Foreground="White" Background="Transparent"
                    BorderThickness="0" Padding="16,10" FontSize="14"/>
            <!-- TODO: Command bundet til ShowTripsCommand -->
            <Button Content="🗺  Trips"
                    Command="{Binding ShowTripsCommand}"
                    Foreground="White" Background="Transparent"
                    BorderThickness="0" Padding="16,10" FontSize="14"/>
        </StackPanel>

        <!-- Indholdsomraade — viser CarView eller TripView automatisk -->
        <!-- TODO: Content bundet til CurrentViewModel -->
        <ContentControl Content="{Binding CurrentViewModel}" Margin="8"/>

    </DockPanel>
</Window>
